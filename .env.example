# 数据库（默认使用仓库根目录 data/aiops.db）
DATABASE_URL=

# 告警窗口
DEDUP_WINDOW_SECONDS=300
CLUSTER_WINDOW_SECONDS=300
CLUSTER_COOLDOWN_SECONDS=600
CLUSTER_REOPEN_SECONDS=1800
CORRELATION_WINDOW_SECONDS=180
INCIDENT_COOLDOWN_SECONDS=600

# LLM: auto = 有凭据用真实模型，无凭据自动 Mock；llm = 只用真实模型（失败降级）；mock = 只用 Mock
LLM_MODE=auto
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-chat
LLM_TIMEOUT_SECONDS=20
LLM_MAX_RETRIES=1

# 证据预算与置信度
EVIDENCE_MAX_ALERTS=20
EVIDENCE_MAX_LOG_LINES=40
EVIDENCE_MAX_CHARS=8000
REVIEW_CONFIDENCE_THRESHOLD=0.45
DEGRADED_CONFIDENCE_CAP=0.6

# Webhook 可选共享令牌（留空不校验）
WEBHOOK_TOKEN=
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://127.0.0.1:8000
